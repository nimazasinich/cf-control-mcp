# Local development only. Copy to .env / .dev.vars as appropriate for your setup.
# Never commit real values.

GATEWAY_AUTH_TOKEN=
MCP_AUTH_TOKEN=

# Cloudflare account/control-plane credentials used by Admin/provider provisioning.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional AI Gateway authentication token used for authenticated provider passthroughs
# and non-default BYOK aliases. Store as a Worker secret in production:
#   wrangler secret put CF_AIG_TOKEN
CF_AIG_TOKEN=

# CF_AIG_GATEWAY_SLUG is non-secret and is configured in wrangler.jsonc.
# Workers AI uses the `AI` binding declared in wrangler.jsonc and does not require
# an upstream provider API token.
