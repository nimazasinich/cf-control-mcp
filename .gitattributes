# Normalize line endings in the repository to LF regardless of the
# committing platform. This prevents the entire tree from showing as
# "modified" on Windows checkouts (core.autocrlf) whenever a Linux/macOS
# tool or CI runner touches the same files.
* text=auto eol=lf

# Windows-native scripts keep CRLF so double-clicking / cmd.exe behaves.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# POSIX shell scripts must stay LF.
*.sh text eol=lf

# Binary-ish assets: never text-normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
