{
  "name": "cf-control-mcp",
  "main": "src/oauth-worker.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    // Cloudflare AI Gateway slug for the provider gateway (not a secret).
    // When set, POST /v1/chat/completions routes via:
    //   https://gateway.ai.cloudflare.com/v1/{account_id}/cf-control-mcp/compat/chat/completions
    // Leave empty to fall back to direct Google AI Studio calls.
    // Create the gateway in: Cloudflare Dashboard → AI → AI Gateway → New Gateway
    "CF_AIG_GATEWAY_SLUG": "cf-control-mcp"
  },
  "d1_databases": [
    {
      "binding": "DM_DB",
      "database_name": "DM_DB",
      "database_id": "138a2aef-9f5a-4635-8346-dc474fdfff93"
    }
  ]
}
