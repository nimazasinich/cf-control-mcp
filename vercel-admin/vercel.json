{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/admin",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://cf-control-mcp.amin-chinisaz-edu.workers.dev/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://cf-control-mcp.amin-chinisaz-edu.workers.dev/admin/:path*"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
